# Copy to .env (never commit .env). Docker passes these into the container.
# WARNING: agents in /workspace have shell access inside the container, so they can read these values. Only use them on a machine you trust.
# Subscription (personal use): run "claude setup-token" on your PC and paste the token
CLAUDE_CODE_OAUTH_TOKEN=
# or an API key:
# ANTHROPIC_API_KEY=
